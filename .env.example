APP_NAME=Local News Aggregator
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./data/news.db
SOURCES_FILE=config/sources.json
NOTICE_SOURCES_FILE=config/notice_sources.json

# LLM — OpenRouter (openai_compatible mode)
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen/qwen3-4b
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=sk-or-v1-your-key-here
OPENAI_COMPATIBLE_REFERER=https://your-app.vercel.app
OPENAI_COMPATIBLE_TITLE=NewsApp
REQUIRE_LLM=false
LLM_TIMEOUT_SECONDS=60

# These MLX settings are kept for local development only; ignored in cloud mode
MLX_TEMPERATURE=0.2
MLX_TOP_P=0.9
MLX_NO_THINK=true

REQUEST_USER_AGENT=LocalNewsAggregator/1.0 (+local research app)
FEED_FETCH_TIMEOUT_SECONDS=20
ARTICLE_FETCH_TIMEOUT_SECONDS=20
FEED_FETCH_CONCURRENCY=8
ARTICLE_FETCH_CONCURRENCY=12
MAX_ARTICLES_PER_RUN=250
# Refresh filters the full RSS collection once, then Load More only paginates saved cards.
IMPORTANT_STORY_MIN_SCORE=5.2
IMPORTANT_MULTI_SOURCE_MIN_SCORE=3.8
IMPORTANT_STORY_MAX_CARDS=250
PROCESS_ALL_ARTICLES_PER_IMPORTANT_STORY=true
CATEGORY_LLM_ENABLED=false
CACHE_THUMBNAILS_DURING_INGESTION=false

SCHEDULER_ENABLED=true
INGESTION_HOUR=6
INGESTION_MINUTE=30
AUTO_INGEST_ON_STARTUP=false
