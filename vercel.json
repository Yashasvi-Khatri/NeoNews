{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/s/:path*",
      "destination": "/api/index.py"
    }
  ]
}
